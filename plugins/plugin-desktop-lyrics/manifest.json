{
    "name": "DesktopLyrics",
    "author": "deeadly137",
    "version": "0.3.0",
    "icon": "lyrics",
    "description": "Synced lyrics on the desktop, or on top of normal windows, with midnight-shell's options.",
    "tags": [
        "lyrics",
        "music",
        "media",
        "desktop"
    ],
    "settings": "settings.qml",
    "entryPoints": [
        {
            "type": "desktop-widget",
            "source": "DesktopLyrics.qml",
            "properties": {
                "layer": "bottom",
                "overlay": false
            }
        },
        {
            "type": "desktop-widget",
            "source": "DesktopLyrics.qml",
            "properties": {
                "layer": "top",
                "overlay": true
            }
        }
    ]
}
